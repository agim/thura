// Data shapes for thura: the single source for Go structs (schema/),
// the Postgres DDL and migrations (db/), and the client types. Run
// `lidza gen` after editing; `lidza dev` does it on save.
//
// model: a table and a struct. type: an API shape. enum: a fixed set.

type Greeting {
  name    string @min(1) @max(100)
  message string
}

model Workspace {
  id uuid @id @default(uuid())
  name string @min(1) @max(120)
  createdAt time @default(now())
}

model Contact {
  id uuid @id @default(uuid())
  workspaceId uuid @ref(Workspace) @index
  name string @min(1) @max(200)
  email string @email @max(254)
  company string @default("") @max(200)
  phone string @default("") @max(80)
  favorite bool @default(false)
  createdAt time @default(now())
}

type WorkspaceList {
  items Workspace[]
}
type ContactList {
  items Contact[]
  nextCursor string
}
type ContactInput {
  name string @min(1) @max(200)
  email string @email @max(254)
  company string? @max(200)
  phone string? @max(80)
  favorite bool
}

type ProvisionAccountInput {
  email string @email @max(254)
  name string @min(1) @max(200)
  password string @min(12) @max(200)
}
type CreateWorkspaceInput {
  name string @min(1) @max(120)
  ownerEmail string @email @max(254)
}

enum WorkspaceRole { owner admin member }

model Invitation {
  id uuid @id @default(uuid())
  workspaceId uuid @ref(Workspace) @index
  email string @email @max(254)
  role WorkspaceRole
  tokenHash string @unique
  invitedBy string
  expiresAt time
  acceptedAt time?
  revokedAt time?
  createdAt time @default(now())
}

type InviteInput {
  email string @email @max(254)
  role WorkspaceRole
}
type InviteView {
  id uuid
  email string
  role WorkspaceRole
  expiresAt time
  acceptedAt time?
  revokedAt time?
}
type InviteList {
  items InviteView[]
}
type AcceptInviteInput {
  token string @min(20) @max(200)
  name string? @max(200)
  password string? @max(200)
}
type MemberView {
  subject string
  email string
  name string
  role WorkspaceRole
}
type MemberList {
  items MemberView[]
}
type RoleInput {
  role WorkspaceRole
}

type AuditDetail {
  name string
  value string
}
type WorkspaceAuditRecord {
  id uuid
  at time
  actor string
  action string
  resource string
  outcome string
  requestId string
  details AuditDetail[]
}
type WorkspaceAuditList {
  items WorkspaceAuditRecord[]
  nextCursor string
}

model DrivePreview {
  id uuid @id @default(uuid())
  fileId uuid @ref(DriveFile) @unique
  version int
  status string @default("pending")
  objectKey string @default("")
  checksum string @default("")
  contentType string @default("")
  width int @default(0)
  height int @default(0)
  truncated bool @default(false)
  updatedAt time @default(now())
  jobId string @default("")
}
type FilePreview {
  fileId uuid
  version int
  status string
  contentType string
  data string
  width int
  height int
  truncated bool
}

enum MailFolder { inbox drafts sent archive trash spam }

model Mailbox {
  id uuid @id @default(uuid())
  workspaceId uuid @ref(Workspace) @index
  name string @max(120)
  address string @email @max(254)
  configPrefix string @max(100)
  signature text @default("")
  createdAt time @default(now())
}
model MailItem {
  id uuid @id @default(uuid())
  mailboxId uuid @ref(Mailbox) @index
  authorId string
  folder MailFolder
  fromAddress string @default("")
  toAddress string @default("")
  cc string @default("")
  bcc string @default("")
  subject string @default("")
  textBody text @default("")
  htmlBody text @default("")
  status string @default("draft")
  starred bool @default(false)
  unread bool @default(false)
  providerId string @default("")
  rawKey string @default("")
  externalId string?
  threadId string @default("")
  messageId string @default("")
  inReplyTo string @default("")
  referencesHeader string @default("")
  sendAt time?
  createdAt time @default(now())
  updatedAt time @default(now())
  @@unique(mailboxId, externalId)
}
model MailAttachment {
  id uuid @id @default(uuid())
  itemId uuid @ref(MailItem) @index
  name string
  contentType string
  size int
  objectKey string
  contentId string @default("")
}
type MailboxList {
  items Mailbox[]
}
type MailItemList {
  items MailItem[]
  nextCursor string
}
type AttachmentView {
  id uuid
  name string
  contentType string
  size int
  contentId string
}
type MailDetail {
  item MailItem
  attachments AttachmentView[]
  labels MailLabel[]
}
type DraftInput {
  forwardId uuid?
  replyId uuid?
  replyAll bool?
  to string? @max(2000)
  cc string? @max(2000)
  bcc string? @max(2000)
  subject string? @max(500)
  text string? @max(500000)
  html string? @max(500000)
  threadId string? @max(500)
}
type MailFlags {
  folder MailFolder?
  starred bool?
  unread bool?
}
type SendMailInput {
  sendAt time?
}
type ProvisionMailboxInput {
  workspaceId uuid
  name string @min(1) @max(120)
  address string @email @max(254)
  configPrefix string? @max(100)
}
type FileContent {
  name string
  contentType string
  data string
}

// Types of the auth pack.
model AuthSession @table("auth_session") {
  id          string @id
  subject     string @index
  refreshHash string @unique
  prevRefreshHash string?
  rotatedAt   time?
  expiresAt   time
  revokedAt   time?
  remember    bool   @default(true)
  createdAt   time   @default(now())
}

model AuthToken @table("auth_token") {
  id        string @id
  purpose   string @index
  subject   string @index
  hash      string @unique
  expiresAt time
  usedAt    time?
  createdAt time   @default(now())
}

// Every account that ever signed in, kept by the auth pack: who, when
// first and last, and whether an admin disabled it.
model AuthAccount @table("auth_account") {
  subject     string @id
  label       string?
  disabledAt  time?
  firstSeenAt time   @default(now())
  lastSeenAt  time   @default(now())
}

// The pack's own users, for apps that mount its sign-in (auth.Mount):
// email and password for local sign-in, or no password for an account
// that only signs in through a provider. An app with its own users table
// leaves this one empty.
model AuthUser @table("auth_user") {
  subject      string @id
  email        string? @unique
  name         string?
  passwordHash string?
  verifiedAt   time?
  createdAt    time   @default(now())
  updatedAt    time   @default(now())
}

// One row per provider account (Google, GitHub, an OIDC issuer) linked
// to a subject; id is provider:providerSubject.
model AuthIdentity @table("auth_identity") {
  id              string @id
  provider        string @index
  providerSubject string
  subject         string @index
  email           string?
  name            string?
  createdAt       time   @default(now())
  lastUsedAt      time   @default(now())
}

// One row per external account a user connected (auth.Conn): the grant's
// tokens sealed with the master key, never sent to the browser; id is
// provider:owner.
model AuthConnection @table("auth_connection") {
  id            string @id
  owner         string
  provider      string
  subject       string
  login         string @default("")
  scopes        string @default("")
  tokenType     string @default("")
  accessSealed  string
  refreshSealed string @default("")
  expiresAt     time?
  reconnect     bool   @default(false)
  createdAt     time   @default(now())
  updatedAt     time   @default(now())
  @@unique(owner, provider)
}

// One role a subject holds in a scope (auth.Roles): a team, a
// workspace, or "" for the whole app. The roles' permissions are the
// app's, in code.
model AuthMember @table("auth_member") {
  id        uuid   @id @default(uuid())
  subject   string
  scope     string @default("")
  role      string
  grantedBy string?
  createdAt time   @default(now())
  @@unique(subject, scope, role)
  @@index(scope, role)
}

// Types of the jobs pack.
// Background jobs (jobs.Queue). uniqueKey is set by jobs.Unique while the
// job is pending or running and cleared when it finishes; NULLs do not
// collide, so the unique index holds one live job per kind and key.
model Job @table("job") {
  id          uuid   @id @default(uuid())
  kind        string
  payload     json
  state       string @default("pending")
  runAt       time   @default(now())
  attempts    int    @default(0)
  maxAttempts int    @default(5)
  lockedAt    time?
  finishedAt  time?
  lastError   text?
  createdAt   time   @default(now())
  uniqueKey   string?
  @@index(state, runAt)
  @@unique(kind, uniqueKey)
}

// Recurring schedules (jobs.Queue.Schedule): one row per scheduled kind
// with its next due time; the node that moves nextRunAt on enqueues.
model JobSchedule @table("job_schedule") {
  kind      string @id
  spec      string
  nextRunAt time
  lastRunAt time?
  lastJobId uuid?
  updatedAt time   @default(now())
}

// Types of the mail pack.
// Types of the mail pack: the outbox, one row per message sent or queued.
model MailMessage @table("mail_message") {
  id         uuid   @id @default(uuid())
  recipient  string @index
  fromAddress string?
  replyTo    string?
  headers    json?
  cc         string[]?
  bcc        string[]?
  attachments json?
  subject    string
  text       text?
  html       text?
  template   string?
  status     string @index
  providerId string?
  error      text?
  attempts   int
  createdAt  time   @default(now()) @index
  sentAt     time?
}

model DriveFolder {
 id uuid @id @default(uuid())
 workspaceId uuid @ref(Workspace) @index
 parentId uuid?
 name string @min(1) @max(200)
 createdAt time @default(now())
}
model DriveFile {
 id uuid @id @default(uuid())
 workspaceId uuid @ref(Workspace) @index
 folderId uuid?
 name string @min(1) @max(200)
 contentType string
 size int
 currentVersion int @default(1)
 trashed bool @default(false)
 createdAt time @default(now())
 updatedAt time @default(now())
}
model FileVersion {
 id uuid @id @default(uuid())
 fileId uuid @ref(DriveFile) @index
 number int
 objectKey string @index
 checksum string
 size int
 createdBy string
 createdAt time @default(now())
 @@unique(fileId,number)
}
model UploadSession {
 id uuid @id @default(uuid())
 workspaceId uuid @ref(Workspace) @index
 subject string
 fileId uuid?
 folderId uuid?
 name string
 contentType string
 expectedSize int
 baseVersion int
 expiresAt time
 completedAt time?
 createdAt time @default(now())
}
model UploadChunk {
 id uuid @id @default(uuid())
 sessionId uuid @ref(UploadSession) @index
 number int
 size int
 checksum string
 objectKey string @index
 @@unique(sessionId,number)
}
model ShareGrant {
 id uuid @id @default(uuid())
 fileId uuid @ref(DriveFile) @index
 tokenHash string @unique
 targetEmail string @default("")
 expiresAt time
 revokedAt time?
 createdAt time @default(now())
}
type DriveListing {
 folders DriveFolder[]
 files DriveFile[]
}
type FolderInput {
 name string @min(1) @max(200)
 parentId uuid?
}
type UploadInput {
 name string @min(1) @max(200)
 contentType string @max(200)
 size int @min(1) @max(10485760)
 fileId uuid?
 folderId uuid?
 baseVersion int @min(0)
}
type UploadState {
 session UploadSession
 chunks int[]
}
type DriveFlags {
 name string? @min(1) @max(200)
 folderId uuid?
 trashed bool
}
type VersionView {
 number int
 checksum string
 size int
 createdBy string
 createdAt time
}
type VersionList {
 items VersionView[]
}
type ShareInput {
 targetEmail string? @email
 expiresAt time
}
type ShareView {
 id uuid
 targetEmail string
 expiresAt time
 revokedAt time?
}
type ShareList {
 items ShareView[]
}
type ShareCreated {
 grant ShareView
 token string
}
type OpenShareInput {
 token string @min(20) @max(200)
}

model OfficeSession {
 id uuid @id @default(uuid())
 fileId uuid @ref(DriveFile) @index
