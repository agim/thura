}
type EventInput {
 resetExceptions bool
 title string @min(1) @max(500)
 description string? @max(20000)
 location string? @max(1000)
 allDay bool
 startDate string?
 endDate string?
 startsAt time?
 endsAt time?
 timeZone string @min(1) @max(100)
 rrule string? @max(500)
 sequence int @min(0)
