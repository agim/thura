 startsAt time?
 endsAt time?
 startDate string?
 endDate string?
 @@unique(eventId,instanceKey)
}
enum Attendance { needsaction accepted tentative declined }
model EventAttendee {
 id uuid @id @default(uuid())
 eventId uuid @ref(CalendarEvent) @index
 email string @email
 response Attendance @default(needsaction)
 responseSequence int @default(0)
 @@unique(eventId,email)
}
type CalendarList {
