// Types of the audit pack.
// The audit log (packs/audit): who did what to which resource, when,
// and how it went; newest first by at, then id.
model AuditEvent @table("audit_event") {
  id        uuid   @id @default(uuid())
  at        time   @default(now())
  actor     string
  action    string
  resource  string @default("")
  scope     string @default("")
  outcome   string
  requestId string @default("")
  meta      json
  @@index(at, id)
  @@index(actor, at)
  @@index(scope, at)
}

// Opt-in SMIP receive/review boundary; never grants remote workspace membership.
model SmipBinding {
  id uuid @id
  workspaceId uuid @ref(Workspace) @index
  peer string
  stream string
  sender string
  recipient string
  enabled bool @default(true)
  createdBy string
  createdAt time @default(now())
  @@unique(peer, stream, recipient)
}
model SmipInbox {
  id uuid @id @default(uuid())
  workspaceId uuid @ref(Workspace) @index
  bindingId uuid @ref(SmipBinding)
  origin string
  messageId string
  digest string
  record text
  originKey text
  receiptKey text
  sender string @default("")
  recipient string @default("")
  stream string @default("")
  body text @default("")
  name string @default("")
  kind string
  size int
  importedFileId uuid?
  importedAt time?
  acceptedAt time
  @@unique(origin, messageId)
}
type SmipBindingInput {
  requestId uuid
  peer string @min(1) @max(253)
  stream string @min(1) @max(128)
  sender string @min(1) @max(382)
  recipient string @min(1) @max(382)
}
type SmipBindingList {
  items SmipBinding[]
  sendablePeers string[]
  configured bool
}
type SmipInboxItem {
  id uuid
  bindingId uuid
  origin string
  messageId string
  sender string
  recipient string
  stream string
  kind string
  body string
  name string
  size int
  digest string
  acceptedAt time
  importedFileId uuid?
  importedAt time?
}
type SmipInboxList {
  items SmipInboxItem[]
  nextCursor string
}
type SmipImportInput {
  folderId uuid?
}

model SmipOutbox {
 id uuid @id
 origin string @default("")
 workspaceId uuid @ref(Workspace) @index
 bindingId uuid @ref(SmipBinding)
 subject string
 packet text
 originKey text
 receipt text @default("")
 receiptKey text @default("")
 kind string
 body text
 name string
 size int
 sourceFileId uuid?
 state string @default("pending")
 reason string @default("")
 attempts int @default(0)
 attemptId string @default("")
 lastStatus int @default(0)
 nextAttempt time
 createdAt time
 updatedAt time
}
type SmipSendInput {
 transactionId uuid
 bindingId uuid
 body string? @max(65536)
 fileId uuid?
}
type SmipOutbound {
 id uuid
 bindingId uuid
 kind string
 body string
 name string
 size int
 sourceFileId uuid?
 state string
 reason string
 attempts int
 lastStatus int
 nextAttempt time
 createdAt time
 updatedAt time
}
type SmipOutboxList {
 items SmipOutbound[]
 nextCursor string
}
type SmipDispatchJob {
 id uuid
}

model ServerSetup {
 id uuid @id @default(uuid())
 subject string @default("")
 workspaceId uuid?
 revision int @default(0)
 publishedRevision int @default(0)
 draft string @default("")
 published string @default("")
 step string @default("server")
 publishedAt time?
}

type SetupStatus {
  administrator bool
 open bool
 claimed bool
 published bool
}

type SetupClaimInput {
 token string @max(512)
 email string @email @max(254)
 name string @min(1) @max(100)
 password string @min(12) @max(1024)
}

// The app's owner claim (AUTH_OWNER_CLAIM): one row, id "owner". The
// token is kept as its hash until an account claims with it; then the
// account is the owner and the row stays, so ownership never reopens.
model AuthOwnerClaim @table("auth_owner_claim") {
  id        string @id
  tokenHash string
  subject   string?
  claimedAt time?
  createdAt time   @default(now())
  updatedAt time   @default(now())
}
