}
model CalendarEvent {
 meetingId uuid? @ref(Meeting)
 id uuid @id @default(uuid())
 calendarId uuid @ref(Calendar) @index
 uid string
 organizer string
 title string @min(1) @max(500)
 description text @default("")
 location string @default("")
 allDay bool
 startDate string @default("")
 endDate string @default("")
 startsAt time?
 endsAt time?
 timeZone string
 rrule string @default("")
 sequence int @default(0)
 cancelled bool @default(false)
 createdAt time @default(now())
 updatedAt time @default(now())
 @@unique(calendarId,uid)
}
model EventException {
