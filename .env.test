# Test environment: lidza test creates and migrates this database.
MAIL_PROVIDER=outbox
STORAGE_PROVIDER=local
STORAGE_DIR=.lidza/test-storage

# Public synthetic relay key, used only by isolated browser test ingress.
MAIL_INBOUND_SECRET=synthetic-browser-reader-secret-at-least-32-characters
LLM_PROVIDER=fake
EMBED_PROVIDER=fake
AUTH_SECRET=test-only-secret-never-used-outside-tests-0123456789

# Deterministic mail fixtures; dedicated protection tests enable and script AI.
MAIL_AI_SCREENING=false
MAIL_RSPAMD_URL=
MAIL_RSPAMD_CONTROLLER_URL=
MAIL_RSPAMD_PASSWORD=
