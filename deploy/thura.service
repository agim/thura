# systemd unit for thura: install the binary and its files under
# /opt/thura (bin/thura, db/, config/credentials.yml.enc, and .env made
# from deploy/production.env plus DATABASE_URL and LIDZA_MASTER_KEY), then:
#   sudo useradd --system --home /opt/thura --shell /usr/sbin/nologin thura
#   sudo cp deploy/thura.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now thura
# TLS: set LIDZA_TLS_DOMAINS in .env and the binary serves 443 itself with
# Let's Encrypt certificates (the capability below lets it bind 80 and 443),
# or put a TLS-terminating reverse proxy in front (docs/lidza-guide.md,
# "Deployment").
[Unit]
Description=thura (Līdza app)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=thura
Group=thura
WorkingDirectory=/opt/thura
EnvironmentFile=/opt/thura/.env
ExecStart=/opt/thura/bin/thura
Restart=always
RestartSec=2
# Hardening: the app writes nothing but logs to stdout.
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/thura

[Install]
WantedBy=multi-user.target
