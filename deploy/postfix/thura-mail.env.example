# Merge these non-secret defaults into the operator's production app settings.
# Change MAIL_FROM to the chosen domain's system/invitation address.
# Same-host private submission only. Public port-25 listener: change port to 25.
MAIL_PROVIDER=smtp
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=2525
MAIL_SMTP_SECURITY=none
MAIL_FROM=CHANGE_ME_TO_YOUR_SYSTEM_ADDRESS
# Seal each mailbox prefix's MAIL_INBOUND_SECRET privately, never in this file.
