{
  "version": 2,
  "required_environment": [
    "LIDZA_MASTER_KEY"
  ],
  "configuration": [
    {
      "name": "LIDZA_MASTER_KEY",
      "stage": "deploy",
      "label": "Application master key",
      "help": "Generate a new key for a fresh database. Keep the original key for upgrades and restores.",
      "secret": true
    },
    {
      "name": "MAIL_PROVIDER",
      "stage": "setup",
      "label": "Outgoing mail provider",
      "help": "Choose and test your sending provider in Thura's setup wizard. Receiving is configured separately."
    },
    {
      "name": "MAIL_FROM",
      "stage": "setup",
      "label": "Sender address",
      "help": "Configure and verify the sender in Thura's setup wizard."
    },
    {
      "name": "LLM_PROVIDER",
      "stage": "setup",
      "label": "AI provider",
      "help": "Configure and enable the required AI provider and model in Thura's setup wizard."
    }
  ],
  "generated_secrets": [
    "THURA_SETUP_TOKEN",
    "THURA_POSTFIX_TOKEN",
    "MAIL_RSPAMD_PASSWORD",
    "LIVEKIT_API_KEY",
    "LIVEKIT_API_SECRET",
    "COLLABORA_TOKEN_SECRET",
    "THURA_SERVICE_MATRIX_AS_TOKEN",
    "THURA_SERVICE_MATRIX_HS_TOKEN"
  ],
  "services": [
    {
      "name": "app",
      "role": "app",
      "policy": "init",
      "build": {
        "dockerfile": "Dockerfile",
        "target": "compact"
      },
      "aliases": [
        "thura"
      ],
      "environment": {
        "DB_MIGRATE": "true",
        "DB_MAX_CONNS": "8",
        "CACHE_URL": "redis://127.0.0.1:6379/1",
        "REALTIME_BUS_URL": "redis://127.0.0.1:6379/2",
        "MAIL_CLAMD_ADDRESS": "127.0.0.1:3310",
        "MAIL_RSPAMD_URL": "http://127.0.0.1:11333",
        "MAIL_RSPAMD_CONTROLLER_URL": "http://127.0.0.1:11334",
        "LIVEKIT_SERVER_URL": "http://127.0.0.1:7880",
        "LIVEKIT_PUBLIC_URL": "wss://${APP_DOMAIN}/rtc",
        "COLLABORA_SERVER_URL": "http://office:9980",
        "COLLABORA_APP_URL": "http://thura:3000",
        "THURA_PUBLIC_HOSTS": "thura,${APP_DOMAIN}",
        "THURA_SERVICE_HTTP_ORIGINS": "http://127.0.0.1:7880,http://office:9980,http://thura:3000,http://127.0.0.1:8008",
        "THURA_MAIL_INBOUND": "postfix",
        "THURA_MANAGED_MATRIX": "true",
        "THURA_MANAGED_SETTINGS": "MATRIX_SERVER_URL,MATRIX_SERVER_NAME,MATRIX_AS_TOKEN,COLLABORA_SERVER_URL,COLLABORA_APP_URL,COLLABORA_TOKEN_SECRET,LIVEKIT_SERVER_URL,LIVEKIT_PUBLIC_URL,LIVEKIT_API_KEY,LIVEKIT_API_SECRET,MAIL_RSPAMD_URL,MAIL_RSPAMD_CONTROLLER_URL,MAIL_RSPAMD_PASSWORD,MAIL_CLAMD_ADDRESS",
        "THURA_SERVICE_MATRIX_SERVER_URL": "http://127.0.0.1:8008",
        "THURA_SERVICE_MATRIX_SERVER_NAME": "${APP_DOMAIN}",
        "THURA_MANAGED_OLLAMA": "true",
        "THURA_MANAGED_STATE_IN_STORAGE": "true"
      },
      "public_ports": [
        {
          "port": 25,
          "protocol": "tcp"
        },
        {
          "port": 7881,
          "protocol": "tcp"
        },
        {
          "port": 7882,
          "protocol": "udp"
        }
      ],
      "http_routes": [
        {
          "prefix": "/rtc",
          "port": 7880,
          "strip_prefix": true
        }
      ],
      "health_command": [
        "python3",
        "/opt/thura/app.py",
        "--health"
      ]
    },
    {
      "name": "mail",
      "role": "mail",
      "policy": "mail",
      "build": {
        "dockerfile": "deploy/compact/mail.Dockerfile"
      },
      "share_app_network": true,
      "environment": {
        "THURA_POSTFIX_MANAGED": "true",
        "THURA_POSTFIX_TOKEN": "${THURA_POSTFIX_TOKEN}",
        "MAIL_RSPAMD_PASSWORD": "${MAIL_RSPAMD_PASSWORD}"
      },
      "volumes": [
        {
          "name": "postfix-queue",
          "target": "/var/spool/postfix"
        },
        {
          "name": "rspamd-state",
          "target": "/var/lib/rspamd"
        },
        {
          "name": "clamav-signatures",
          "target": "/var/lib/clamav"
        },
        {
          "name": "mail-filter-learning",
          "target": "/var/lib/thura-valkey"
        }
      ],
      "health_command": [
        "python3",
        "/opt/thura/compact.py",
        "--health"
      ]
    },
    {
      "name": "office",
      "role": "office",
      "policy": "office",
      "command": [
        "--o:ssl.enable=false",
        "--o:ssl.termination=true",
        "--o:net.service_root=/api/v1/collabora",
        "--o:storage.wopi.alias_groups[@mode]=groups",
        "--o:storage.wopi.alias_groups.group[0].host=http://thura:3000",
        "--o:storage.wopi.alias_groups.group[0].host[@allow]=true",
        "--o:admin_console.enable=false",
        "--o:logging.level=warning",
        "--o:num_prespawn_children=1",
        "--o:per_document.max_concurrency=1"
      ],
      "health_command": [
        "/usr/local/bin/thura-office-health"
      ],
      "build": {
        "dockerfile": "deploy/compact/office.Dockerfile"
      }
    }
  ],
  "bootstrap_readiness": {
    "path": "/api/v1/health",
    "readyz_body_contains": "Server setup is required",
    "setup_path": "/setup"
  },
  "profile_resources": {
    "minimum": {
      "services": {
        "app": {
          "memory_mib": 1024,
          "cpus": "0.75"
        },
        "mail": {
          "memory_mib": 1536,
          "cpus": "0.5"
        },
        "office": {
          "memory_mib": 768,
          "cpus": "0.5"
        }
      },
      "database": {
        "memory_mib": 256,
        "cpus": "0.25"
      }
    },
    "standard": {
      "services": {
        "app": {
          "memory_mib": 2048,
          "cpus": "1.5"
        },
        "mail": {
          "memory_mib": 2560,
          "cpus": "1"
        },
        "office": {
          "memory_mib": 2048,
          "cpus": "1"
        }
      },
      "database": {
        "memory_mib": 512,
        "cpus": "0.5"
      }
    },
    "performance": {
      "services": {
        "app": {
          "memory_mib": 4096,
          "cpus": "3"
        },
        "mail": {
          "memory_mib": 4096,
          "cpus": "2"
        },
        "office": {
          "memory_mib": 5120,
          "cpus": "2"
        }
      },
      "database": {
        "memory_mib": 1024,
        "cpus": "1"
      }
    }
  }
}
